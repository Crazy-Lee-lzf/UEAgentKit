{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^ueak\\.operation/1\\.[0-9]+$"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-zA-Z0-9_]*)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "domain": {
      "enum": [
        "graph",
        "asset",
        "memory",
        "layout",
        "extension"
      ]
    },
    "targetKind": {
      "type": "string"
    },
    "parametersSchema": {
      "type": "object"
    },
    "outputsSchema": {
      "type": "object"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "readOnly": {
      "type": "boolean"
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "requires": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "editor": {
          "type": "boolean"
        },
        "transaction": {
          "type": "boolean"
        },
        "compile": {
          "type": "boolean"
        },
        "save": {
          "type": "boolean"
        },
        "policyKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "revisionScope": {
          "enum": [
            "none",
            "asset",
            "graph",
            "asset+graph"
          ]
        }
      },
      "required": [
        "editor",
        "transaction",
        "compile",
        "save",
        "policyKeys",
        "revisionScope"
      ]
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "postconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "rollback": {
      "enum": [
        "reverse-ops",
        "undo",
        "none"
      ]
    },
    "idempotency": {
      "enum": [
        "required",
        "optional",
        "none"
      ]
    },
    "errorCodes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "implementation": {
      "enum": [
        "core",
        "extension-e1",
        "extension-e2",
        "extension-e3"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optional": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "required",
        "optional"
      ]
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "value",
            "structure"
          ]
        },
        "snapshot": {
          "enum": [
            "io",
            "graph"
          ]
        },
        "rollback": {
          "enum": [
            "reverse-ops",
            "undo",
            "none"
          ]
        }
      },
      "required": [
        "kind",
        "snapshot",
        "rollback"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxOperationsPerInvocation": {
          "type": "integer"
        },
        "maxAffectedNodes": {
          "type": "integer"
        },
        "timeoutMs": {
          "type": "integer"
        }
      },
      "required": [
        "maxOperationsPerInvocation",
        "maxAffectedNodes",
        "timeoutMs"
      ]
    },
    "minHostVersion": {
      "type": "string"
    },
    "deprecated": {
      "type": "boolean"
    },
    "replacement": {
      "type": "string"
    },
    "requiresExplicitConfirmation": {
      "type": "boolean"
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "version",
    "domain",
    "targetKind",
    "parametersSchema",
    "outputsSchema",
    "capabilities",
    "readOnly",
    "risk",
    "requires",
    "preconditions",
    "postconditions",
    "rollback",
    "idempotency",
    "errorCodes",
    "implementation",
    "evidence",
    "transaction",
    "limits",
    "minHostVersion",
    "deprecated"
  ]
}
