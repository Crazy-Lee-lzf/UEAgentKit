{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^ueak\\.typedgraph/1\\.[0-9]+$"
    },
    "graphId": {
      "type": "string",
      "pattern": "^g:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|name:[A-Za-z_][A-Za-z0-9_]{0,63})$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/Game/[A-Za-z0-9_./-]{1,240}$"
        },
        "class": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "revisionPolicy": {
          "enum": [
            "executor-computed",
            "index-snapshot"
          ]
        },
        "dirty": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "class",
        "revision",
        "revisionPolicy",
        "dirty"
      ]
    },
    "graph": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "guid": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "enum": [
            "event",
            "function",
            "macro",
            "ubergraph",
            "delegate-signature",
            "other"
          ]
        },
        "schema": {
          "type": "string"
        },
        "editable": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "guid",
        "kind",
        "schema",
        "editable"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "live-editor",
            "commandlet-export",
            "test-fixture"
          ]
        },
        "sessionId": {
          "type": "string"
        },
        "exporterSchemaVersion": {
          "type": "string"
        },
        "pluginBuildHash": {
          "type": "string"
        },
        "engineVersion": {
          "type": "string"
        },
        "exportedAtUtc": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "sessionId",
        "exporterSchemaVersion",
        "pluginBuildHash",
        "engineVersion",
        "exportedAtUtc"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxNodes": {
          "type": "integer"
        },
        "maxPins": {
          "type": "integer"
        },
        "includedNodeCount": {
          "type": "integer"
        },
        "omittedNodeCount": {
          "type": "integer"
        },
        "selection": {
          "enum": [
            "nodeId-ascending"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "maxNodes",
        "maxPins",
        "truncated"
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^n:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|obj:[A-Za-z_][A-Za-z0-9_]{0,127})$"
          },
          "nodeGuid": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "objectPath": {
            "type": "string"
          },
          "classPath": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "event",
              "call",
              "variable-get",
              "variable-set",
              "macro",
              "cast",
              "comment",
              "reroute",
              "other"
            ]
          },
          "nodeIdSource": {
            "enum": [
              "guid",
              "object-name"
            ]
          },
          "flags": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "pure": {
                "type": "boolean"
              },
              "reroute": {
                "type": "boolean"
              },
              "comment": {
                "type": "boolean"
              },
              "latent": {
                "type": "boolean"
              }
            },
            "required": [
              "enabled",
              "pure",
              "reroute",
              "comment",
              "latent"
            ]
          },
          "position": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y"
            ]
          },
          "size": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              },
              "source": {
                "enum": [
                  "measured",
                  "stored",
                  "estimated",
                  "unknown"
                ]
              }
            },
            "required": [
              "width",
              "height",
              "source"
            ]
          },
          "pins": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^p:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|dup:[0-9a-f-]{36}:[0-9a-f-]{36})$"
            }
          },
          "semanticHash": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "required": [
          "nodeId",
          "nodeGuid",
          "classPath",
          "kind",
          "flags",
          "position",
          "size",
          "pins"
        ]
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "pinId": {
            "type": "string",
            "pattern": "^p:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|dup:[0-9a-f-]{36}:[0-9a-f-]{36})$"
          },
          "nodeId": {
            "type": "string",
            "pattern": "^n:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|obj:[A-Za-z_][A-Za-z0-9_]{0,127})$"
          },
          "name": {
            "type": "string"
          },
          "friendlyName": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "input",
              "output"
            ]
          },
          "kind": {
            "enum": [
              "exec",
              "data"
            ]
          },
          "type": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string"
              },
              "subCategory": {
                "type": "string"
              },
              "subCategoryObject": {
                "type": "string"
              },
              "container": {
                "type": "string"
              },
              "isReference": {
                "type": "boolean"
              },
              "isConst": {
                "type": "boolean"
              },
              "isWeakPointer": {
                "type": "boolean"
              }
            },
            "required": [
              "category",
              "subCategory",
              "subCategoryObject",
              "container",
              "isReference",
              "isConst",
              "isWeakPointer"
            ]
          },
          "index": {
            "type": "integer"
          },
          "defaults": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "value": {
                "type": "string"
              },
              "object": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "value",
              "object",
              "text"
            ]
          },
          "flags": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hidden": {
                "type": "boolean"
              },
              "advanced": {
                "type": "boolean"
              },
              "connectable": {
                "type": "boolean"
              },
              "orphaned": {
                "type": "boolean"
              },
              "defaultReadOnly": {
                "type": "boolean"
              },
              "defaultIgnored": {
                "type": "boolean"
              }
            },
            "required": [
              "hidden",
              "advanced",
              "connectable",
              "orphaned",
              "defaultReadOnly",
              "defaultIgnored"
            ]
          },
          "links": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^p:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|dup:[0-9a-f-]{36}:[0-9a-f-]{36})$"
            }
          },
          "pinIdSource": {
            "enum": [
              "native",
              "derived"
            ]
          },
          "pinGuidTransient": {
            "type": "boolean"
          }
        },
        "required": [
          "pinId",
          "nodeId",
          "name",
          "direction",
          "kind",
          "type",
          "index",
          "defaults",
          "flags",
          "links"
        ]
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "edgeId": {
            "type": "string",
            "pattern": "^e:p:(dup:)?[0-9a-f-]{36}(:[0-9a-f-]{36})?--p:(dup:)?[0-9a-f-]{36}(:[0-9a-f-]{36})?$"
          },
          "from": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "^n:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|obj:[A-Za-z_][A-Za-z0-9_]{0,127})$"
              },
              "pinId": {
                "type": "string",
                "pattern": "^p:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|dup:[0-9a-f-]{36}:[0-9a-f-]{36})$"
              }
            },
            "required": [
              "nodeId",
              "pinId"
            ]
          },
          "to": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "nodeId": {
                "type": "string",
                "pattern": "^n:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|obj:[A-Za-z_][A-Za-z0-9_]{0,127})$"
              },
              "pinId": {
                "type": "string",
                "pattern": "^p:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|dup:[0-9a-f-]{36}:[0-9a-f-]{36})$"
              }
            },
            "required": [
              "nodeId",
              "pinId"
            ]
          },
          "kind": {
            "enum": [
              "exec",
              "data"
            ]
          },
          "origin": {
            "enum": [
              "pin-link",
              "patch"
            ]
          },
          "status": {
            "enum": [
              "resolved",
              "dangling",
              "duplicate",
              "wrong-kind"
            ]
          }
        },
        "required": [
          "edgeId",
          "from",
          "to",
          "kind",
          "origin",
          "status"
        ]
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "nodeId": {
            "type": "string",
            "pattern": "^n:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|obj:[A-Za-z_][A-Za-z0-9_]{0,127})$"
          },
          "text": {
            "type": "string"
          },
          "bounds": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "integer"
              },
              "y": {
                "type": "integer"
              },
              "width": {
                "type": "integer"
              },
              "height": {
                "type": "integer"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height"
            ]
          },
          "containedNodeIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^n:([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}|obj:[A-Za-z_][A-Za-z0-9_]{0,127})$"
            }
          }
        },
        "required": [
          "nodeId",
          "text",
          "bounds",
          "containedNodeIds"
        ]
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "info",
              "warning",
              "error"
            ]
          },
          "message": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "context": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "required": [
          "code",
          "severity",
          "message",
          "path"
        ]
      }
    },
    "semanticHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "layoutHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "graphId",
    "asset",
    "graph",
    "source",
    "limits",
    "nodes",
    "pins",
    "edges",
    "comments",
    "diagnostics",
    "semanticHash",
    "layoutHash"
  ]
}
