{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^ueak\\.node-descriptor/1\\.[0-9]+$"
    },
    "actionId": {
      "type": "string",
      "pattern": "^action:[0-9a-f]{32}$"
    },
    "discoveryKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "nodeClass": {
          "type": "string"
        },
        "spawnerClass": {
          "type": "string"
        },
        "graphSchema": {
          "type": "string"
        },
        "actionKind": {
          "enum": [
            "callFunction",
            "event",
            "variableGet",
            "variableSet",
            "macro",
            "cast",
            "delegate",
            "component",
            "special"
          ]
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "functionPath": {
              "type": "string"
            },
            "eventName": {
              "type": "string"
            },
            "variableName": {
              "type": "string"
            },
            "macroGraph": {
              "type": "string"
            },
            "targetClass": {
              "type": "string"
            },
            "delegateName": {
              "type": "string"
            },
            "componentClass": {
              "type": "string"
            },
            "specialKind": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "nodeClass",
        "spawnerClass",
        "graphSchema",
        "actionKind",
        "payload"
      ]
    },
    "title": {
      "type": "string"
    },
    "menuName": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "keywords": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "searchTokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "graphKinds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "graphSchemas": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pins": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "input",
              "output"
            ]
          },
          "kind": {
            "enum": [
              "exec",
              "data"
            ]
          },
          "type": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string"
              },
              "subCategory": {
                "type": "string"
              },
              "subCategoryObject": {
                "type": "string"
              },
              "container": {
                "type": "string"
              },
              "isReference": {
                "type": "boolean"
              },
              "isConst": {
                "type": "boolean"
              },
              "isWeakPointer": {
                "type": "boolean"
              }
            },
            "required": [
              "category",
              "subCategory",
              "subCategoryObject",
              "container",
              "isReference",
              "isConst",
              "isWeakPointer"
            ]
          },
          "optional": {
            "type": "boolean"
          },
          "dynamic": {
            "type": "boolean"
          },
          "variadic": {
            "type": "boolean"
          },
          "default": {
            "type": "string"
          },
          "hidden": {
            "type": "boolean"
          },
          "advanced": {
            "type": "boolean"
          },
          "connectable": {
            "type": "boolean"
          },
          "defaultReadOnly": {
            "type": "boolean"
          },
          "defaultIgnored": {
            "type": "boolean"
          }
        },
        "required": [
          "name",
          "direction",
          "kind",
          "type"
        ]
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requiresBlueprintContext": {
          "type": "boolean"
        },
        "requiresTarget": {
          "type": "boolean"
        },
        "requiresWorldContext": {
          "type": "boolean"
        },
        "pure": {
          "type": "boolean"
        },
        "latent": {
          "type": "boolean"
        },
        "variadic": {
          "type": "boolean"
        },
        "hiddenByDefault": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "requiresBlueprintContext",
        "requiresTarget",
        "requiresWorldContext",
        "pure",
        "latent",
        "variadic",
        "hiddenByDefault"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "FBlueprintActionDatabase"
          ]
        },
        "engineVersion": {
          "type": "string"
        },
        "actionDatabaseFingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{16}$"
        },
        "pluginBuildHash": {
          "type": "string"
        },
        "discoveredAtUtc": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "engineVersion",
        "actionDatabaseFingerprint",
        "pluginBuildHash",
        "discoveredAtUtc"
      ]
    },
    "risk": {
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "capability": {
      "enum": [
        "core",
        "extension-e1",
        "extension-e2",
        "extension-e3"
      ]
    },
    "trustLevel": {
      "enum": [
        "official",
        "project",
        "third-party"
      ]
    },
    "descriptorDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{16}$"
    }
  },
  "required": [
    "schemaVersion",
    "actionId",
    "discoveryKey",
    "title",
    "menuName",
    "category",
    "keywords",
    "searchTokens",
    "graphKinds",
    "graphSchemas",
    "pins",
    "constraints",
    "source",
    "risk",
    "capability",
    "trustLevel",
    "descriptorDigest"
  ]
}
