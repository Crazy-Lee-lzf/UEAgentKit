{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Crazy-Lee-lzf/UEAgentKit/blob/main/spec/patch.schema.json",
  "title": "UEAgentKit Patch",
  "description": "Declarative Blueprint and policy-gated asset patch request.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "patchId",
    "projectName",
    "assets"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "patchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "projectName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "description": {
      "type": "string",
      "maxLength": 4096
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    }
  },
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "assetClass": {
      "type": "string",
      "pattern": "^/Script/[^.]+\\.[^.]+$"
    },
    "guid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "scalar": {
      "type": [
        "string",
        "number",
        "integer",
        "boolean",
        "null"
      ]
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetPath",
        "expectedRevision",
        "operations"
      ],
      "properties": {
        "assetPath": {
          "type": "string",
          "pattern": "^/Game/.+\\.[^./]+$"
        },
        "expectedRevision": {
          "$ref": "#/$defs/revision"
        },
        "expectedAssetClass": {
          "$ref": "#/$defs/assetClass"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/setVariableDefault"
              },
              {
                "$ref": "#/$defs/setComponentProperty"
              },
              {
                "$ref": "#/$defs/setPinDefault"
              },
              {
                "$ref": "#/$defs/setBlueprintDescription"
              },
              {
                "$ref": "#/$defs/setAssetProperty"
              },
              {
                "$ref": "#/$defs/setMaterialInstanceScalarParameter"
              },
              {
                "$ref": "#/$defs/setMaterialInstanceVectorParameter"
              },
              {
                "$ref": "#/$defs/setMaterialInstanceTextureParameter"
              },
              {
                "$ref": "#/$defs/setMaterialInstanceStaticSwitchParameter"
              },
              {
                "$ref": "#/$defs/setDataTableCell"
              },
              {
                "$ref": "#/$defs/setDataTableRowFields"
              }
            ]
          }
        }
      }
    },
    "operationBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operationId",
        "operation",
        "target",
        "value"
      ],
      "properties": {
        "operationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "type": "string"
        },
        "target": {
          "type": "object"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/scalar"
            },
            {
              "$ref": "#/$defs/colorVector"
            },
            {
              "$ref": "#/$defs/dataTableFieldMap"
            }
          ]
        }
      }
    },
    "setVariableDefault": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setVariableDefault"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "variableName"
              ],
              "properties": {
                "variableName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "$ref": "#/$defs/scalar"
            }
          }
        }
      ]
    },
    "setComponentProperty": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setComponentProperty"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "componentName",
                "propertyPath"
              ],
              "properties": {
                "componentName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "propertyPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[^.]+(?:\\.[^.]+)*$"
                }
              }
            },
            "value": {
              "$ref": "#/$defs/scalar"
            }
          }
        }
      ]
    },
    "setPinDefault": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setPinDefault"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "graphGuid",
                "nodeGuid",
                "pinName"
              ],
              "properties": {
                "graphGuid": {
                  "$ref": "#/$defs/guid"
                },
                "nodeGuid": {
                  "$ref": "#/$defs/guid"
                },
                "pinName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "$ref": "#/$defs/scalar"
            }
          }
        }
      ]
    },
    "setBlueprintDescription": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setBlueprintDescription"
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "maxProperties": 0
            },
            "value": {
              "type": "string",
              "maxLength": 4096
            }
          }
        }
      ]
    },
    "setAssetProperty": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setAssetProperty"
            },
            "target": {
              "type": "object",
              "required": [
                "propertyPath"
              ],
              "additionalProperties": false,
              "properties": {
                "propertyPath": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 512,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
                }
              }
            },
            "value": {
              "$ref": "#/$defs/scalar"
            }
          }
        }
      ]
    },
    "setMaterialInstanceScalarParameter": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setMaterialInstanceScalarParameter"
            },
            "target": {
              "type": "object",
              "required": [
                "parameterName"
              ],
              "additionalProperties": false,
              "properties": {
                "parameterName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "type": "number"
            }
          }
        }
      ]
    },
    "colorVector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "number"
        },
        "g": {
          "type": "number"
        },
        "b": {
          "type": "number"
        },
        "a": {
          "type": "number"
        }
      }
    },
    "setMaterialInstanceVectorParameter": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setMaterialInstanceVectorParameter"
            },
            "target": {
              "type": "object",
              "required": [
                "parameterName"
              ],
              "additionalProperties": false,
              "properties": {
                "parameterName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "$ref": "#/$defs/colorVector"
            }
          }
        }
      ]
    },
    "assetObjectPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^/Game/(?:[^./\\\\]+/)*[^./\\\\]+\\.[^./\\\\]+$"
    },
    "setMaterialInstanceTextureParameter": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setMaterialInstanceTextureParameter"
            },
            "target": {
              "type": "object",
              "required": [
                "parameterName"
              ],
              "additionalProperties": false,
              "properties": {
                "parameterName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "$ref": "#/$defs/assetObjectPath"
            }
          }
        }
      ]
    },
    "setMaterialInstanceStaticSwitchParameter": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setMaterialInstanceStaticSwitchParameter"
            },
            "target": {
              "type": "object",
              "required": [
                "parameterName"
              ],
              "additionalProperties": false,
              "properties": {
                "parameterName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "setDataTableCell": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setDataTableCell"
            },
            "target": {
              "type": "object",
              "required": [
                "rowName",
                "fieldName"
              ],
              "additionalProperties": false,
              "properties": {
                "rowName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                },
                "fieldName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean"
              ]
            }
          }
        }
      ]
    },
    "setDataTableRowFields": {
      "allOf": [
        {
          "$ref": "#/$defs/operationBase"
        },
        {
          "properties": {
            "operation": {
              "const": "setDataTableRowFields"
            },
            "target": {
              "type": "object",
              "required": [
                "rowName"
              ],
              "additionalProperties": false,
              "properties": {
                "rowName": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            },
            "value": {
              "$ref": "#/$defs/dataTableFieldMap"
            }
          }
        }
      ]
    },
    "dataTableFieldMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 32,
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[^.]+$"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "integer",
          "boolean"
        ]
      }
    }
  }
}
