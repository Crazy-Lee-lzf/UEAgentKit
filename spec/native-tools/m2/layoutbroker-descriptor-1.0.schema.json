{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueagentkit.local/schemas/layoutbroker-descriptor-1.0.schema.json",
  "title": "UEAgentKit layout broker descriptor v1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "address",
    "port",
    "token",
    "projectName",
    "projectPathHash",
    "brokerVersion",
    "supportedContractVersions",
    "algorithms",
    "startedAtUtc",
    "processId",
    "maxConcurrentJobs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "ueak.layoutbroker-descriptor/1.0"
    },
    "address": {
      "const": "127.0.0.1"
    },
    "port": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535
    },
    "token": {
      "type": "string",
      "pattern": "^[0-9a-f]{32,128}$"
    },
    "projectName": {
      "type": "string",
      "minLength": 1
    },
    "projectPathHash": {
      "type": "string",
      "pattern": "^sha1:[0-9a-f]{40}$"
    },
    "brokerVersion": {
      "type": "string",
      "minLength": 1
    },
    "supportedContractVersions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "ueak.layoutbroker/1.0"
      }
    },
    "algorithms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "contains": {
        "$ref": "#/$defs/algorithm"
      }
    },
    "startedAtUtc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "processId": {
      "type": "integer",
      "minimum": 1
    },
    "maxConcurrentJobs": {
      "const": 1
    }
  },
  "$defs": {
    "algorithm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "p0-layered"
        },
        "version": {
          "const": "1.0.0"
        }
      }
    }
  }
}
