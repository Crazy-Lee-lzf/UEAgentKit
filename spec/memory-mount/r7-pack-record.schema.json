{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ueagentkit.local/schemas/r7-pack-record-v1.schema.json",
  "title": "R7 Knowledge Pack Record v1",
  "description": "One canonical JSON line in records.jsonl. See spec/memory-mount/R7_MOUNT_CONTRACT.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordId",
    "recordType",
    "subjectKey",
    "title",
    "body",
    "sourceKind",
    "updatedAtUtc"
  ],
  "properties": {
    "recordId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "recordType": {
      "enum": [
        "projectFact",
        "projectRule",
        "decisionRecord",
        "knownIssue",
        "taskRecord",
        "runtimeEvidence"
      ]
    },
    "subjectKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32768
    },
    "sourceKind": {
      "enum": ["user-confirmed", "tool-observed", "model-inferred"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "status": {
      "enum": ["valid", "unverified", "stale"]
    },
    "scopes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scopeType", "scopeKey"],
        "properties": {
          "scopeType": {
            "enum": [
              "project",
              "asset",
              "symbol",
              "graph",
              "node",
              "dataTableRow",
              "log",
              "file",
              "external"
            ]
          },
          "scopeKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "details": {
            "type": "object"
          }
        }
      }
    },
    "updatedAtUtc": {
      "type": "string",
      "format": "date-time"
    },
    "details": {
      "type": "object"
    }
  }
}
